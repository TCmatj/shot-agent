{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "shot-agent 默认桌面能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "allow-authorize-workspace-directory",
    "allow-get-default-workspace-directory",
    "allow-force-close-application",
    "allow-download-generated-media-to-canvas-folder",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" }
      ]
    }
  ]
}

